NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PEXELS_API_KEY=
# Server-only. Never expose this as NEXT_PUBLIC_* or import it into client code.
SUPABASE_SERVICE_ROLE_KEY=
# Turnstile: restrict the widget to your site hostname in Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Server-only random secret, at least 32 characters; generate 32 random bytes.
# Keep identical across application instances. Rotation invalidates visitor cookies.
SECURITY_SECRET=
# Optional, leave provider empty to disable all product analytics.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://plausible.io/api/event
# Public contact for privacy/removal requests.
NEXT_PUBLIC_SUPPORT_EMAIL=
