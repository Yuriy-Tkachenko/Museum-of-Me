{
  "name": "museum-of-me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "start:prod": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed:mock": "node scripts/seed-mock.mjs",
    "test:security": "node --test tests/security.test.cjs",
    "test:security:db": "node tests/security-db.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:ui": "node scripts/check-local-ui.mjs",
    "supabase:check": "node scripts/check-supabase.mjs",
    "supabase:prepare": "node scripts/prepare-supabase.mjs",
    "db:start": "supabase start -x realtime,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/brygada-1918": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/neucha": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/rubik-dirt": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.3",
    "postcss": "^8.5.28",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=22.0.0 <25"
  }
}
